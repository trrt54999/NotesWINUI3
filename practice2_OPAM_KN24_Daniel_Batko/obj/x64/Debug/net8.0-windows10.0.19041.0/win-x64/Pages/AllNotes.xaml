<?xml version="1.0" encoding="utf-8" ?>
<Page x:ConnectionId='1'
    x:Class="practice2_OPAM_KN24_Daniel_Batko.Pages.AllNotes"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:practice2_OPAM_KN24_Daniel_Batko.UserControls"
    xmlns:entity="using:practice2_OPAM_KN24_Daniel_Batko.Entities"
    xmlns:local="using:practice2_OPAM_KN24_Daniel_Batko.Pages">

    <Grid RowDefinitions="Auto, *" Style="{StaticResource PageGridStyle}">
        <RelativePanel Grid.Row="0" HorizontalAlignment="Stretch" Margin="12">
            <TextBox x:ConnectionId='6'
                x:Name="SearhTextBox"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.LeftOf="SearchButton"
                                                        />
            <Button x:ConnectionId='7'
                x:Name="SearchButton"
                Margin="12,0,0,0"
                                          
                RelativePanel.AlignRightWithPanel="True">
                <FontIcon Glyph="" />
            </Button>
        </RelativePanel>
        <ItemsView x:ConnectionId='2'
            x:Name="NotesItemView"
            Grid.Row="1"
            Margin="12"
                                                     >
            <ItemsView.ItemTemplate>
                <DataTemplate                          >
                    <ItemContainer x:ConnectionId='4'>
                        <controls:NotesCard x:ConnectionId='5'                             />
                    </ItemContainer>
                </DataTemplate>
            </ItemsView.ItemTemplate>
            <ItemsView.Layout>
                <UniformGridLayout
                    MaximumRowsOrColumns="3"          
                    MinColumnSpacing="12"
                    MinItemWidth="0"
                    MinRowSpacing="12"
                    Orientation="Horizontal" />
            </ItemsView.Layout>
        </ItemsView>
    </Grid>
</Page>

