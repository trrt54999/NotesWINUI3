<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="practice2_OPAM_KN24_Daniel_Batko.Pages.NoteDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entity="using:practice2_OPAM_KN24_Daniel_Batko.Entities"
    xmlns:local="using:practice2_OPAM_KN24_Daniel_Batko.Pages"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowDefinitions="Auto, *, Auto" Style="{StaticResource PageGridStyle}">
        <TextBlock
            Grid.Row="0"
            Margin="12"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{x:Bind Note.NotesTitle, Mode=OneWay}" />
        <ScrollViewer Grid.Row="1" Margin="12">
            <StackPanel Spacing="16">
                <Image
                    MaxWidth="400"
                    Source="{x:Bind Note.ImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                    Stretch="Uniform"
                    Visibility="{x:Bind Note.ImagePath, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Category" />
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Note.Category, Mode=OneWay}" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Content" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Note.Content, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Created Date" />
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Note.CreatedDate, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}}" />

                <StackPanel
                    x:Name="ReminderInfoPanel"
                    Spacing="4"
                    Visibility="{x:Bind Note.HasReminder, Mode=OneWay}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Reminder" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Foreground="{ThemeResource SystemAccentColor}"
                            Glyph="&#xE823;" />
                        <TextBlock
                            Foreground="{ThemeResource SystemAccentColor}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ReminderDateTimeText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="2"
            Margin="12"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="Back_Click" Content="Back" />
        </StackPanel>
    </Grid>
</Page>