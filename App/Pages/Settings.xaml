<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="practice2_OPAM_KN24_Daniel_Batko.Pages.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:practice2_OPAM_KN24_Daniel_Batko.Pages"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <ComboBox
                x:Name="ThemeComboBox"
                Width="200"
                Header="Select Theme"
                SelectionChanged="ThemeComboBox_SelectionChanged">
                <ComboBoxItem Content="Light" Tag="Light" />
                <ComboBoxItem Content="Dark" Tag="Dark" />
                <ComboBoxItem Content="Default" Tag="Default" />
            </ComboBox>

            <ToggleSwitch
                x:Name="SoundToggleSwitch"
                Width="200"
                Header="System Sounds"
                IsOn="{x:Bind IsSoundEnabled, Mode=TwoWay}"
                OffContent="Off"
                OnContent="On"
                Toggled="SoundToggleSwitch_Toggled" />

            <Button
                x:Name="DeleteAccountButton"
                Click="DeleteAccountButton_Click"
                Content="Delete Account"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>