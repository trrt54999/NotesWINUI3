<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="practice2_OPAM_KN24_Daniel_Batko.UserControls.NotesCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:practice2_OPAM_KN24_Daniel_Batko.UserControls">
    <Border
        MaxWidth="350"
        Padding="12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource OverlayCornerRadius}">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <Image
                x:Name="Image"
                Grid.RowSpan="5"
                Grid.Column="0"
                Width="80"
                Height="120"
                Margin="0,0,12,0"
                VerticalAlignment="Top"
                Stretch="UniformToFill" />
            <TextBlock
                x:Name="NotesTitle"
                Grid.Row="0"
                Grid.Column="1"
                MaxWidth="220"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="Category"
                Grid.Row="2"
                Grid.Column="1"
                MaxWidth="220"
                Margin="0,4,0,0"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="Content"
                Grid.Row="3"
                Grid.Column="1"
                MaxWidth="220"
                Margin="0,8,0,0"
                Style="{StaticResource BodyTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <StackPanel
                x:Name="ReminderPanel"
                Grid.Row="4"
                Grid.Column="1"
                MaxWidth="220"
                Margin="0,8,0,0"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <FontIcon
                    Margin="0,0,8,0"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Foreground="{ThemeResource SystemAccentColor}"
                    Glyph="&#xE823;" />
                <TextBlock
                    x:Name="ReminderTime"
                    MaxWidth="220"
                    Foreground="{ThemeResource SystemAccentColor}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
            <StackPanel
                Grid.Row="5"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="FavoriteButton"
                    Click="FavoriteButton_Click"
                    PointerEntered="FavoriteButton_PointerEntered"
                    PointerExited="FavoriteButton_PointerExited">
                    <FontIcon
                        x:Name="FavoriteStar"
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BooleanToStarColorConverter}}"
                        Glyph="&#xE734;" />
                </Button>
                <Button x:Name="EditButton" Click="EditButton_Click">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70F;" />
                </Button>
                <Button x:Name="DeleteButton" Click="DeleteButton_Click">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>